  "metadata": {
    "name": "coffer_rewards",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Permissionless, backend-authorized cumulative reward campaigns"
  },
  "instructions": [
    {
      "name": "claim_native",
      "docs": [
        "Pay the signer's SOL entitlement up to the cumulative `total` of a voucher",
        "that the preceding Ed25519 instruction verified and that is valid until",
        "`expires_at` (Unix seconds). Pays what liquidity and the payout limit allow;",
        "the same voucher collects the rest later. `callback` runs afterwards."
      ],
      "discriminator": [
        169,
        122,
        132,
        23,
        2,
        52,
        2,
        241
      ],
      "accounts": [
        {
          "name": "user",
          "docs": [
            "Beneficiary named in the voucher. Receives the SOL and pays the receipt rent once."
          ],
          "writable": true,
          "signer": true
        },
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "vault",
          "writable": true
        },
        {
          "name": "receipt",
          "docs": [
            "Lifetime payout counter at `[\"receipt\", campaign, user]`."
          ],
          "writable": true
        },
        {
          "name": "instructions"
        },
        {
          "name": "system_program"
        }
      ],
      "args": [
        {
          "name": "total",
          "type": "u64"
        },
        {
          "name": "expires_at",
          "type": "i64"
        },
        {
          "name": "callback",
          "type": {
            "option": {
              "defined": {
                "name": "RewardCallback"
              }
            }
          }
        }
      ]
    },
