    { "test": "t22_neg_18_check_leverage_edges", "virtual": "0", "actual": "0", "ok": false },
    { "test": "t22_neg_18_check_leverage_edges", "virtual": "18446744073709551615", "actual": "18446744073709551615", "ok": false },
    { "test": "t22_neg_18_check_leverage_edges", "virtual": "0", "actual": "18446744073709551615", "ok": false },
    { "test": "t22_pos_01_guard_accepts_fresh_pool_and_ignores_unused_slots", "virtual": "1000000000", "actual": "0", "ok": true }
  ],
  "minVirtualBalance": [
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 0, "expected": "1000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 3, "expected": "1000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 4, "expected": "10000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 6, "expected": "1000000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 8, "expected": "100000000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 9, "expected": "1000000000" },
    { "test": "t22_pos_02_min_virtual_balance_values", "decimals": 18, "expected": "1000000000000000000" },
