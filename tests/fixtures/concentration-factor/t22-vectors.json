    { "test": "t22_pos_09_exit_near_total_normalises", "virtual": "150", "actual": "100", "payout": "99", "burned": "990", "supply": "1000", "expected": "2" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor", "virtual": "1000", "actual": "500", "payout": "100", "burned": "1", "supply": "1000", "expected": "800" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor", "virtual": "36454400000", "actual": "3645440", "payout": "1", "burned": "1", "supply": "1000", "expected": "36454390000" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor", "virtual": "7", "actual": "5", "payout": "1", "burned": "1", "supply": "1000", "expected": "5" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor", "virtual": "200", "actual": "100", "payout": "50", "burned": "1", "supply": "1000", "expected": "100" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor", "virtual": "18446744073709551615", "actual": "1", "payout": "0", "burned": "1", "supply": "1000", "expected": "18446744073709551615" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor (sidelined leg)", "virtual": "900000", "actual": "0", "payout": "0", "burned": "1", "supply": "10000", "expected": "899910" },
    { "test": "t22_pos_10_non_boundary_exits_are_byte_identical_to_the_old_floor (sidelined leg)", "virtual": "1", "actual": "0", "payout": "0", "burned": "999", "supply": "1000", "expected": "1" }
  ],
  "rescale": [
    { "test": "t22_pos_14_rescale_repairs_and_is_price_neutral", "virtual": ["1", "13099000000", "7000000000"], "actual": ["1", "13099", "6000000000"], "decimals": [0, 0, 0], "multiplier": "1000", "ok": true, "expected": ["1000", "13099000000000", "7000000000000"], "repaired": [0] },
    { "test": "t22_pos_15_rescale_mainnet_dust_pool_by_1e9", "virtual": ["1", "13099", "2", "50", "3000", "9", "777"], "actual": ["1", "200", "0", "10", "100", "8", "0"], "decimals": [9, 9, 9, 9, 9, 9, 9], "multiplier": "1000000000", "ok": true, "expected": ["1000000000", "13099000000000", "2000000000", "50000000000", "3000000000000", "9000000000", "777000000000"], "repaired": [0] },
    { "test": "t22_neg_11_rescale_rejections_write_nothing", "virtual": ["1", "2000000000"], "actual": ["1", "1000000000"], "decimals": [9, 9], "multiplier": "0", "ok": false, "error": "InvalidVirtualRescale" },
    { "test": "t22_neg_11_rescale_rejections_write_nothing", "virtual": ["1", "2000000000"], "actual": ["1", "1000000000"], "decimals": [9, 9], "multiplier": "1", "ok": false, "error": "InvalidVirtualRescale" },
    { "test": "t22_neg_11_rescale_rejections_write_nothing", "virtual": ["1", "2000000000"], "actual": ["1", "1000000000"], "decimals": [9, 9], "multiplier": "18446744073709551615", "ok": false, "error": "MathOverflow" },
    { "test": "t22_neg_11_rescale_rejections_write_nothing (m = 2 repairs slot 0 but leaves it below the 1e9 floor)", "virtual": ["1", "2000000000"], "actual": ["1", "1000000000"], "decimals": [9, 9], "multiplier": "2", "ok": false, "error": "VirtualBalanceBelowFloor" },
    { "test": "t22_neg_11_rescale_rejections_write_nothing (m = 2 on V=1, A=5)", "virtual": ["1", "2000000000"], "actual": ["5", "1000000000"], "decimals": [9, 9], "multiplier": "2", "ok": false, "error": "VirtualBalanceNotAboveActual" },
    { "test": "t22_neg_11_rescale_rejections_write_nothing (zero virtual)", "virtual": ["0", "2000000000"], "actual": ["0", "1000000000"], "decimals": [9, 9], "multiplier": "2", "ok": false, "error": "InvalidVirtualBalances" }
  ]
