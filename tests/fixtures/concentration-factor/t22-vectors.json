    { "test": "t22_neg_01_init_floor", "virtual": ["999999999", "1000000000"], "decimals": [6, 9], "ok": true, "violations": [] },
    { "test": "t22_neg_01_init_floor", "virtual": ["999999", "1000000000"], "decimals": [6, 9], "ok": false, "violations": [0] },
    { "test": "t22_pos_02_min_virtual_balance_values", "virtual": ["1000", "10000"], "decimals": [0, 4], "ok": true, "violations": [] },
    { "test": "t22_pos_02_min_virtual_balance_values", "virtual": ["999", "10000"], "decimals": [0, 4], "ok": false, "violations": [0] }
  ],
  "seedGate": [
    { "test": "t22_pos_03_seed_gate_accepts_boundary_and_sidelined", "virtual": ["1000000000", "1000000000"], "net": ["999999999", "999999999"], "ok": true },
    { "test": "t22_pos_03_seed_gate_accepts_boundary_and_sidelined", "virtual": ["1000000000", "1"], "net": ["999999999", "0"], "ok": true },
    { "test": "t22_pos_03_seed_gate_accepts_boundary_and_sidelined", "virtual": ["7", "7", "7"], "net": ["0", "0", "6"], "ok": true },
    { "test": "t22_neg_02_seed_gate_rejects_equal_and_above", "virtual": ["1000000000", "1000000000"], "net": ["1000000000", "1"], "ok": false, "error": "VirtualBalanceNotAboveActual" },
    { "test": "t22_neg_02_seed_gate_rejects_equal_and_above", "virtual": ["1000000000", "1000000000"], "net": ["1", "2000000000"], "ok": false, "error": "VirtualBalanceNotAboveActual" },
    { "test": "t22_neg_02_seed_gate_rejects_equal_and_above", "virtual": ["1", "1"], "net": ["0", "1"], "ok": false, "error": "VirtualBalanceNotAboveActual" },
    { "test": "t22_neg_02_seed_gate_rejects_equal_and_above", "virtual": ["1", "1"], "net": ["0"], "ok": false, "error": "InvalidArrayLength" }
  ],
  "fundGate": [
    { "test": "t22_pos_04_fund_gate_accepts_boundary", "virtual": "1000000000", "net": "999999999", "ok": true },
    { "test": "t22_pos_04_fund_gate_accepts_boundary", "virtual": "2", "net": "1", "ok": true },
    { "test": "t22_neg_03_fund_gate_rejects_equal_and_above", "virtual": "98144", "net": "98144", "ok": false },
    { "test": "t22_neg_03_fund_gate_rejects_equal_and_above", "virtual": "98144", "net": "100000", "ok": false },
    { "test": "t22_neg_03_fund_gate_rejects_equal_and_above", "virtual": "1", "net": "1", "ok": false }
  ],
