{
  "name": "@coffer_so/sdk-v6",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Coffer DEX SDK for the v6 Coffer Pool contracts (Token-2022 transfer fees and hooks, planned single-token deposits) on Solana",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "env:mainnet": "cp .env.mainnet .env && echo 'Active env: MAINNET'",
    "env:testnet": "cp .env.testnet .env && echo 'Active env: TESTNET'",
    "env:show": "grep -E '^NETWORK=' .env || echo 'no .env'",
    "build": "tsc --declaration",
    "prepublishOnly": "rm -rf dist && npm run build",
    "build:mainnet": "npm run env:mainnet && npm run build",
    "build:testnet": "npm run env:testnet && npm run build",
    "test": "jest",
    "lint": "tsc --noEmit",
    "types:generate": "node scripts/generate-contract-types.cjs",
    "types:check": "node scripts/generate-contract-types.cjs --check",
    "abi:check": "node scripts/check-contract-abi.cjs --contracts-dir ../contracts",
    "fixtures:rust": "python3 tests/math/generate-rust-reference.py ../contracts"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "solana",
    "dex",
    "amm",
    "coffer",
    "sdk",
    "token-2022",
    "v6"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^1.4.0",
    "@solana/spl-token": "^0.4.14",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.95.0",
    "@types/bn.js": "^5.1.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
